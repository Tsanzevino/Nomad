config_version=5

[application]

config/name="Nomad"
run/main_scene="uid://c1xgfmun1gkuv"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PlayerStats="*res://player_stats.gd"

[debug]

